QWidget#nctiBaseDialogTitleBar{
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
	border: none;
	background: #FBFCFE;
}

QLabel#nctiBaseDialogTitle{
	color: #52555A;
	font-family: "HarmonyOS Sans SC";
	font-size: 16px;
	margin-left: 16px;
}

QFrame#frameTxt{
	border-top: 1px solid #F0F2F7;
}

QFrame#frameBtn{
	border-top: 1px solid #F0F2F7;
}

QFrame#frameBtn QPushButton#noSaveBtn {
	border: 1px solid #1C72F3;
	border-radius: 4px;
	background-color: transparent;
	color: #1C72F3;
	font-size: 14px;
}

QFrame#frameBtn QPushButton#saveBtn {
	border: 1px solid #1C72F3;
	border-radius: 4px;
	background-color: #1C72F3;
	color: #FFFFFF;
	font-size: 14px;
}