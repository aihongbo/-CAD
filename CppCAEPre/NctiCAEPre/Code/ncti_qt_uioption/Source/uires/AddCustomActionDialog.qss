QWidget#nctiBaseDialogTitleBar{
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
	border: none;
	background: #FBFCFE;
}

QLabel#nctiBaseDialogTitle{
	color: #52555A;
	font-family: "HarmonyOS Sans SC";
	font-size: 16px;
	margin-left: 16px;
}

QFrame#frameTxt{
	border-top: 1px solid #F0F2F7;
}

QFrame#frameTxt > QLabel {
	color: #7C8187;
	font-family: "HarmonyOS Sans SC";
	font-size: 12px;
}

QFrame#frameTxt > QLineEdit {
	border: 1px solid #E6E8EC;
	border-radius: 2px;
	background-color: #FFFFFF;
}

QFrame#frameTxt QToolButton#selectLogoBtn {
	background-color: transparent;
}

QFrame#frameTxt QToolButton#showLogoBtn {
	background-color: #FFFFFF;
	border: none;
	padding: 0px;
	margin: 0px;
	text-align: center;
}

QFrame#frameTxt QToolButton#showLogoBtn:checked {
	background-color: rgba(0, 120, 215, 100);
	border: none;
	padding: 0px;
	margin: 0px;
	text-align: center;
}

QFrame#frameBtn{
	border-top: 1px solid #F0F2F7;
}

QFrame#frameBtn QPushButton#noSaveBtn {
	border: 1px solid #1C72F3;
	border-radius: 4px;
	background-color: transparent;
	color: #1C72F3;
	font-size: 14px;
}

QFrame#frameBtn QPushButton#saveBtn {
	border: 1px solid #1C72F3;
	border-radius: 4px;
	background-color: #1C72F3;
	color: #FFFFFF;
	font-size: 14px;
}