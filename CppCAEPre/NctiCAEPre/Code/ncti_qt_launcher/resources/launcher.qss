/* 弹出菜单 */
NCTI--NctiContextMenu {
    border: 1px solid #dee3ed; 
    border-radius: 4px;
    background-color: #fbfcfe;
	padding: 5px 0px 5px 5px;
}

NCTI--NctiContextMenu::separator {
    height: 1px;
    background-color: #dee3ed;
    margin-left: 5px;
    margin-right: 5px;
}

NCTI--NctiContextMenu::indicator {
    width: 18px;
    height: 18px;
}

NCTI--NctiContextMenu::right-arrow {
    image: url(:/contextmenu/right_arrow.svg);
    width: 18px;
    height: 18px;
}

NCTI--NctiContextMenu::item {
	border: 0px solid transparent;
    margin: 1px 5px 1px 5px;
	padding: 0px 0px 0px 5px;
	min-height: 26px;
	color: #52555A;
	font-size: 13px;
	font-family: "HarmonyOS Sans", "HarmonyOS Sans SC";
}

NCTI--NctiContextMenu::item:selected,
NCTI--NctiContextMenu::item:hover {
    background-color: rgba(102, 121, 168, 0.08);
}

NCTI--NctiContextMenu::item::indicator {
	width: 18px;
    height: 18px;
} 

/* 保存文档窗口*/
NCTI--SaveDocDialog #frameTxt{
	background: #FBFCFE;
	border-top: 1px solid #f0f2f7;
	border-bottom: 1px solid #f0f2f7;
	padding: 16px;
}

NCTI--SaveDocDialog #frameBtn{
	background: #FBFCFE;
	border-bottom-left-radius: 8px;
	border-bottom-right-radius: 8px;
	padding-right: 8px;
	padding-left: 16px; 
}

NCTI--SaveDocDialog #iconLabel {
	width: 56px;
	height: 56px;
	border: none;
}

NCTI--SaveDocDialog #textLabel {
	color: #52555A;
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
}

NCTI--SaveDocDialog #noSaveAllBtn,
NCTI--SaveDocDialog #noSaveBtn {
	background: #fbfcfe;
	border-radius: 4px;
	border: 1px solid #1C72F3;
	color: #1C72F3;
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
}

NCTI--SaveDocDialog #saveBtn {
	background: #1c72f3;
	border-radius: 4px;
	color: #FFFFFF;
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
}

/* 空白页*/
NCTI--MainwindowContainer #blankPage{
	background-color:#fbfcfe;
}

NCTI--MainwindowContainer #newPartBtn{
	border: none;
	background: transparent;
	image: url(:/blankpage/new_part.svg);
}

NCTI--MainwindowContainer #newAssemblyBtn{
	border: none;
	background: transparent;
	image: url(:/blankpage/new_assembly.svg);
}

NCTI--MainwindowContainer #openFileBtn{
	border: none;
	background: transparent;
	image: url(:/blankpage/open_file.svg);
}

/* ====================================================================================================*/
/* 最近文件页*/
NCTI--MainwindowContainer #recentFilePage{
  background-color: #fbfcfe;
}

/* 树状导航栏*/
QTreeWidget{
	background-color: #FFFFFF;
    border: none; 
	font-size: 14px;
	color: #52555A;
	padding-left: 12px;
	padding-top: 12px;
}

QTreeView::branch { 
	image: none; 
}


/* ====================================================================================================*/
/* 搜索栏*/
NCTI--MainwindowContainer #rightSideWidget{
  background-color: #fbfcfe;
}

NCTI--MainwindowContainer #searchWidget{
  background-color: #ffffff;
}

NCTI--MainwindowContainer #searchLineEdit{
    background-color: #F0F2F7;
    border-radius: 2px;
    max-width: 256px;
    min-height: 36px;
	font-size: 14px;
}

NCTI--MainwindowContainer #searchLineEdit::icon {
	width: 20px; 
	height: 20px;
}

NCTI--MainwindowContainer #searchLineEdit:hover {
	border-color: #007BFF;
}

NCTI--MainwindowContainer #recentPageOpenFileBtn{
	background-color: #1C72F3;
	border-radius: 4px;
	font-size: 14px;
	color: #FFFFFF;
}

/* ====================================================================================================*/
/* 最近文件列表栏*/
NCTI--MainwindowContainer #fileDetailGallery{
  border: none; 
  background-color: transparent; 
  margin: 0px; 
  padding: 0px;
}

NCTI--MainwindowContainer #fileDetailGallery > QWidget > QWidget { 
  background: transparent; 
  border: none; 
}



/* ====================================================================================================*/
/* 弹出窗口*/
NCTI--PopupBaseDialog #popup-dialog-frame{
	border-radius: 8px;
	padding-top: 0px;
	padding-left: 0px;
    background-color: #ffffff;
}

/* 弹出窗口-标题栏*/
NCTI--PopupBaseDialog #popup-dialog-title-bar{
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
	background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(243, 245, 248), stop: 1 rgb(210, 213, 216));
	padding: 0px;
}

/* 弹出窗口-标题栏的标题*/
NCTI--PopupBaseDialog #popup-dialog-title{
	color: rgb(81, 84, 87);
	font-family: "HarmonyOS Sans SC";
	font-size: 12px;
	margin-left: 9px;
}

/* 弹出窗口-标题栏的关闭按钮*/
QPushButton#popup-dialog-close-button{
	border:none;
	image: url(:/dialog/close.svg);
	min-width: 16px;
	max-width: 16px;
	min-height: 16px;
	max-height: 16px;
	padding: 4px;
	border-radius: 4px;
}
QPushButton#popup-dialog-close-button:hover{
	background-color: #17000000;
}

/* 弹出窗口-标题栏的取消按钮*/
QPushButton#popup-dialog-cancel-button{
	border: 1px solid #1771f8;
	border-radius: 4px;
	color: #1771f8;
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
	background-color: transparent;
}
QPushButton#popup-dialog-cancel-button:hover{
	background-color: #eaf2ff;
}

/* 弹出窗口-标题栏的确定按钮*/
QPushButton#popup-dialog-ok-button{
	max-height: 32;
	min-height: 32;
	border-radius: 4px;
	background: rgb(23, 113, 248);
	margin: 11px 0px 11px 0px;
	color: rgb(255, 255, 255);
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
}
QPushButton#popup-dialog-ok-button:hover{
	background: rgba(23, 113, 248, 0.8);
}

/* ====================================================================================================*/
/* 新建文档窗口*/
NCTI--NewDocDialog #popup-dialog-title-bar{
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
	border: 1px solid rgb(230, 232, 236);
	background: white;
}

NCTI--NewDocDialog #popup-dialog-title{
	color: #52555A;
	font-family: "HarmonyOS Sans SC";
	font-size: 16px;
	margin-left: 16px;
}

NCTI--NewDocDialog #NewDocDialogContent QLabel{
	color: rgb(81, 84, 87);
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
}
NCTI--NewDocDialog #NewDocDialogContent QComboBox{
	min-width: 200px;
	min-height: 32px;
	border: 1px solid rgb(230, 232, 236);
	border-radius: 2px;
	background: rgb(245, 246, 248);
	color: rgb(124, 129, 135);
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
}
NCTI--NewDocDialog #NewDocDialogContent QComboBox::drop-down{
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 34px;
	border:none;
}
NCTI--NewDocDialog #NewDocDialogContent QComboBox::down-arrow{
	image: url(:/dialog/drop_down.svg);
	padding: 0px;
}

NCTI--NewDocDialog #NewDocDialogContent QComboBox QListView{
	alternate-background-color: #EEEEEE;
	background: white;
	color: rgb(92, 94, 96);
	font-family: "HarmonyOS Sans SC";
	font-size: 13px;
	border: 1px solid rgb(230, 232, 236);
	border-radius: 2px;
}
NCTI--NewDocDialog #NewDocDialogContent QComboBox QListView::item{
	min-height: 30px;
	color: rgb(124, 129, 135);
}

NCTI--NewDocDialog #frame{
	border-top: 1px solid rgb(230, 232, 236);
}
NCTI--NewDocDialog #frame QPushButton{
	border-radius: 4px;
	min-width: 88px;
	min-height: 32px;
	background: rgb(23, 113, 248);
	margin: 17px 20px 17px 0px;
	color: rgb(255, 255, 255);
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
}
NCTI--NewDocDialog #frame QPushButton:hover{
	background: rgb(13, 88, 201);
}
NCTI--NewDocDialog>QWidget{
	border-radius: 4px;
	background-color: white;
}


