/* 弹出窗口*/
NCTI--PopupBaseDialog #popup-dialog-frame{
	border: 1px solid rgb(222, 227, 237);
	border-radius: 8px;
	padding-top: 0px;
	padding-left: 0px;
    background-color: #ffffff;
}

/* 弹出窗口-标题栏*/
NCTI--PopupBaseDialog #popup-dialog-title-bar{
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
	background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(243, 245, 248), stop: 1 rgb(210, 213, 216));
	padding: 0px;
}

/* 弹出窗口-标题栏的标题*/
NCTI--PopupBaseDialog #popup-dialog-title{
	color: rgb(81, 84, 87);
	font-family: "HarmonyOS Sans SC";
	font-size: 12px;
	margin-left: 9px;
}

/* 弹出窗口-标题栏的关闭按钮*/
QPushButton#popup-dialog-close-button{
	border:none;
	image: url(:/Common/dialog_close.svg);
	min-width: 16px;
	max-width: 16px;
	min-height: 16px;
	max-height: 16px;
	padding: 4px;
	border-radius: 4px;
}
QPushButton#popup-dialog-close-button:hover{
	background-color: #17000000;
}

/* 弹出窗口-标题栏的取消按钮*/
QPushButton#popup-dialog-cancel-button{
	border: 1px solid #1771f8;
	border-radius: 4px;
	color: #1771f8;
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
	background-color: transparent;
}
QPushButton#popup-dialog-cancel-button:hover{
	background-color: #eaf2ff;
}

/* 弹出窗口-标题栏的确定按钮*/
QPushButton#popup-dialog-ok-button{
	max-height: 32;
	min-height: 32;
	border-radius: 4px;
	background: rgb(23, 113, 248);
	margin: 11px 0px 11px 0px;
	color: rgb(255, 255, 255);
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
}
QPushButton#popup-dialog-ok-button:hover{
	background: rgba(23, 113, 248, 0.8);
}

/* ====================================================================================================*/
/* 新建文档窗口*/
NCTI--NewDocDialog #popup-dialog-title-bar{
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
	border: 1px solid rgb(230, 232, 236);
	background: white;
}

NCTI--NewDocDialog #popup-dialog-title{
	color: #52555A;
	font-family: "HarmonyOS Sans SC";
	font-size: 16px;
	margin-left: 16px;
}

NCTI--NewDocDialog #NewDocDialogContent QLabel{
	color: rgb(81, 84, 87);
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
}
NCTI--NewDocDialog #NewDocDialogContent QComboBox{
	min-width: 200px;
	min-height: 32px;
	border: 1px solid rgb(230, 232, 236);
	border-radius: 2px;
	background: rgb(245, 246, 248);
	color: rgb(124, 129, 135);
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
}
NCTI--NewDocDialog #NewDocDialogContent QComboBox::drop-down{
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 34px;
	border:none;
}
NCTI--NewDocDialog #NewDocDialogContent QComboBox::down-arrow{
	image: url(:/Common/drop_down.svg);
	padding: 0px;
}

NCTI--NewDocDialog #NewDocDialogContent QComboBox QListView{
	alternate-background-color: #EEEEEE;
	background: white;
	color: rgb(92, 94, 96);
	font-family: "HarmonyOS Sans SC";
	font-size: 13px;
	border: 1px solid rgb(230, 232, 236);
	border-radius: 2px;
}
NCTI--NewDocDialog #NewDocDialogContent QComboBox QListView::item{
	min-height: 30px;
	color: rgb(124, 129, 135);
}

NCTI--NewDocDialog #frame{
	border-top: 1px solid rgb(230, 232, 236);
}
NCTI--NewDocDialog #frame QPushButton{
	border-radius: 4px;
	min-width: 88px;
	min-height: 32px;
	background: rgb(23, 113, 248);
	margin: 17px 20px 17px 0px;
	color: rgb(255, 255, 255);
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
}
NCTI--NewDocDialog #frame QPushButton:hover{
	background: rgb(13, 88, 201);
}
NCTI--NewDocDialog>QWidget{
	border-radius: 4px;
	background-color: white;
}
/* ====================================================================================================*/
/* QuestionDialog */
NCTI--QuestionDialog QLabel#content{
	font-family: "HarmonyOS Sans SC";
	font-size: 16px;
	color: rgb(81, 84, 87);
	margin: 20px 19px 20px 19px;
	min-height: 80px;
}
/* ====================================================================================================*/
/* Dialog */
NCTI--Dialog #dialog-content{
	background: white;
}
NCTI--Dialog #dialog-bottom-button-group{
	border-top: 1px solid rgb(230, 232, 236);
	padding: 16px 24px 16px 24px;
}
NCTI--Dialog #dialog-bottom-button-group QPushButton{
	width: 88px;
	height: 32px;
	border: 1px solid rgb(23, 113, 248);
	border-radius: 4px;
	background: white;
	color: rgb(23, 113, 248);
	font-size: 14px;
}
NCTI--Dialog #dialog-bottom-button-group QPushButton#pushButton_right{
	background: rgb(23, 113, 248);
	color: white;
	margin-left: 12px;
}
NCTI--Dialog #dialog-bottom-button-group QPushButton#pushButton_left:hover{
	border-color: rgb(28, 114, 243);
	color: rgb(13, 88, 201);
}
NCTI--Dialog #dialog-bottom-button-group QPushButton#pushButton_right:hover{
	background: rgb(13, 88, 201);
}

/* ====================================================================================================*/
/* FeatureWidget */
QWidget#FeatureWidget-bottom{
	border-top: 1px solid rgb(230, 232, 236);
}

QWidget#FeatureWidget-contentWgt{
	border-top: 1px solid rgb(230, 232, 236);
	border-bottom: 1px solid rgb(230, 232, 236);
}

QLabel[FeatureWidget-categoryLab=true]{
	font-family: "HarmonyOS Sans SC";
	font-size: 13px;
	font-weight: 500;
	color: rgb(81, 84, 87);
	background-color: transparent;
}

QWidget#featureWidget-widget{
	border-bottom-right-radius: 8px;
	border-bottom-left-radius: 8px;
	width: 313px;
    background-color: #ffffff;
}

QPushButton[featureWidget-btn=true]{
	border: 1px solid #1771f8;
	border-radius: 4px;
	color: #1771f8;
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
	background-color: transparent;
}

QPushButton[featureWidget-btn=true]:hover{
	background-color: #eaf2ff;
}

QLabel[featureWidget-lab=true]{
	color: #7c8187;
	font-family: "HarmonyOS Sans SC";
	font-size: 12px;
}

QLineEdit[featureWidget-lineEdit=true]{
	font-family: "HarmonyOS Sans SC";
	font-size: 12px;
	padding: 2px 10px 2px 10px;
	border: 1px solid rgb(230, 232, 236);
	background: rgb(255, 255, 255);
}

QRadioButton[FeatureWidget-RadioBtn=true]{
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
    background-color: transparent;
	color: rgb(124, 129, 135);
}

QRadioButton[FeatureWidget-RadioBtn=true]::indicator{
	width: 13px;
    height: 13px;
}

QRadioButton[FeatureWidget-RadioBtn=true]::indicator:unchecked{
	image: url(:/Common/radioBtn_unchecked.svg);
}

QRadioButton[FeatureWidget-RadioBtn=true]::indicator:unchecked:hover{
	image: url(:/Common/radioBtn_unchecked_hover.svg);
}

QRadioButton[FeatureWidget-RadioBtn=true]::indicator:checked{
	image: url(:/Common/radioBtn_checked.svg);
}

QComboBox[FeatureWidget-combox=true]{
	min-height: 24px;
	border: 1px solid rgb(230, 232, 236);
	border-radius: 2px;
	background: rgb(245, 246, 248);
	color: rgb(124, 129, 135);
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
}
QComboBox[FeatureWidget-combox=true]::drop-down{
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 34px;
	border:none;
}
QComboBox[FeatureWidget-combox=true]::down-arrow{
	image: url(:/Common/drop_down.svg);
	padding: 0px;
}
QComboBox[FeatureWidget-combox=true]::QListView{
	alternate-background-color: #EEEEEE;
	background: white;
	color: rgb(92, 94, 96);
	font-family: "HarmonyOS Sans SC";
	font-size: 13px;
	border: 1px solid rgb(230, 232, 236);
	border-radius: 2px;
}
QComboBox[FeatureWidget-combox=true]::QListView::item{
	min-height: 30px;
	color: rgb(124, 129, 135);
}
/* ====================================================================================================*/
/* MessageBox */
QFrame#MessageBox-frame{
	max-width: 247px;
	mix-width: 247px;
	border-radius: 8px;
    background-color: #ffffff;
	border: 1px solid rgb(230, 232, 236);
}

QLabel#MessageBox-selModeLab{  
    max-height: 36;
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
	padding-top: 16;
	background: white;
	color: rgb(82, 85, 90);
}

QPushButton#MessageBox-btn{
	max-width: 88px;
	max-height: 32px;
	min-width: 76px;
	min-height: 32px;
    border-radius: 4px;
	background: rgb(23, 113, 248);
	margin: 11px 0px 11px 0px;
	color: rgb(255, 255, 255);
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
}
QPushButton#MessageBox-btn:hover{
	background: rgba(23, 113, 248, 0.8);
}

QWidget#MessageBox-title-bar{
	background: white;
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
	border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}

QWidget#MessageBox-contentWgt{
	min-height: 53px;
	max-height: 53px;
	border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}

QLabel#MessageBox-dialog-title{
	color: rgb(42, 43, 45);
	font-family: "HarmonyOS Sans SC";
	font-size: 16px;
}
QPushButton#MessageBox-close-button{
	border:none;
	image: url(:/Common/dialog_close.svg);
	min-width: 16px;
	max-width: 16px;
	min-height: 16px;
	max-height: 16px;
	padding: 4px;
	border-radius: 4px;
}
QPushButton#MessageBox-close-button:hover{
	background-color: #17000000;
}

/* ====================================================================================================*/
/* 弹窗统一样式 */
#MeshAddForceView,
#MeshAddSpcView,
#MeshAddMatView,
#MeshSettingView{
	min-width: 320px;
	max-width: 360px;
}

/* 标签样式 */
#MeshAddForceView QLabel,
#MeshAddSpcView QLabel,
#MeshAddMatView QLabel,
#MeshSettingView QLabel{
	color: rgb(124, 129, 135);
	font-family: "HarmonyOS Sans SC";
	font-size: 12px;
}

/* 输入框样式 */
#MeshAddForceView QLineEdit,
#MeshAddSpcView QLineEdit,
#MeshAddMatView QLineEdit,
#MeshSettingView QLineEdit{
	color:rgb(81, 84, 87);
	min-height: 24px;
	border: 1px solid rgb(230, 232, 236);
	border-radius: 2px;
	padding-left: 8px;
	padding-right: 8px;
	font-family: "HarmonyOS Sans SC";
	font-size: 12px;
}
#MeshAddForceView QLineEdit:focus,
#MeshAddSpcView QLineEdit:focus,
#MeshAddMatView QLineEdit:focus,
#MeshSettingView QLineEdit:focus{
	border-color: #1771f8;
}
/* 按钮样式 */
#MeshAddForceView QPushButton#pushButton_select,
#MeshAddSpcView QPushButton#pushButton_select,
#MeshAddMatView QPushButton#pushButton_select{
	border: 1px solid rgb(23, 113, 248);
	border-radius: 4px;
	height: 32px;
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
	color: rgb(23, 113, 248);
}
#MeshAddForceView QPushButton#pushButton_select:hover,
#MeshAddSpcView QPushButton#pushButton_select:hover,
#MeshAddMatView QPushButton#pushButton_select:hover{
	background-color: rgba(234, 242, 255, 0.5);
}
#MeshAddForceView QPushButton#pushButton_select:pressed,
#MeshAddSpcView QPushButton#pushButton_select:pressed,
#MeshAddMatView QPushButton#pushButton_select:pressed{
	background-color: rgba(234, 242, 255, 0.7);
}
#MeshAddForceView QPushButton#pushButton_select:checked,
#MeshAddSpcView QPushButton#pushButton_select:checked,
#MeshAddMatView QPushButton#pushButton_select:checked{
	background-color: rgb(234, 242, 255);
}
/* 多行文本编辑框样式 */
#MeshAddForceView #plainTextEdit_describe,
#MeshAddSpcView #plainTextEdit_describe,
#MeshAddMatView #plainTextEdit_comment{
	border: 1px solid rgb(230, 232, 236);
	border-radius: 2px;
	color:rgb(81, 84, 87);
	font-family: "HarmonyOS Sans SC";
	font-size: 12px;
	max-height: 100px;
}
#MeshAddForceView #plainTextEdit_describe:focus,
#MeshAddSpcView #plainTextEdit_describe:focus,
#MeshAddMatView #plainTextEdit_describe:focus{
	border-color: #1771f8;
}
#MeshAddForceView QLabel#label_count,
#MeshAddSpcView QLabel#label_count,
#MeshAddMatView QLabel#label_count{
	color: rgb(23, 113, 248);
	margin-left: 2px;
	margin-right: 2px;
}

/* 集中力 */
#MeshAddForceView{
	padding-left: 20px;
	padding-right: 20px;
}

#MeshAddForceView QLineEdit#lineEdit_y{
	margin-left: 4px;
	margin-right: 4px;
}
/* ====================================================================================================*/
/* 选择和视图模式 */
QToolButton#title_selectMode,
QToolButton#title_visualMode,
QToolButton#title_grid_selectMode  {
	border:none;
	font-size:13px;
	font-family: "HarmonyOS Sans", "HarmonyOS Sans SC";
	color: #52555A;
}

QFrame#ribbon_group_selectMode,
QFrame#ribbon_group_visualMode,
QFrame#ribbon_group_grid_selectMode {
	background-color: transparent; 
	font-size:13px;
	font-family: "HarmonyOS Sans", "HarmonyOS Sans SC";
	color: #52555A;
}

QCheckBox[select_mode_checkbox=true] {
	width: 18px; 
    height: 24px;
	font-family: "HarmonyOS Sans SC";
	font-size: 13px;
	color: #5C6069;
	padding-left: 2px;
	padding-right: 3px;
	border-radius: 1px;
    background-color: transparent;
}

QCheckBox[select_mode_checkbox=true]::indicator {
    width: 16px;
    height: 16px;
	border-radius: 1px;
}

QCheckBox[select_mode_checkbox=true]:unchecked:hover {
	border-radius: 2px;
	background-color: #f2f4fa;
}

QCheckBox[select_mode_checkbox=true]::indicator:checked {
	border-radius: 1px;
	image: url(:/Common/checked.svg);
}

QCheckBox[select_mode_checkbox=true]::indicator:unchecked {
	border-radius: 1px;
	image: url(:/Common/unchecked.svg);
}

QCheckBox[select_mode_checkbox=true]::indicator:checked:disabled {
	border-radius: 2px;
    image: url(:/Common/checked_disable.svg); 
}

/* ====================================================================================================*/
/* 弹出菜单 */
NCTI--NctiContextMenu {
    border: 1px solid #dee3ed; 
    border-radius: 4px;
    background-color: #fbfcfe;
	padding: 5px 0px 5px 5px;
}

NCTI--NctiContextMenu::separator {
    height: 1px;
    background-color: #dee3ed;
    margin-left: 5px;
    margin-right: 5px;
}

NCTI--NctiContextMenu::indicator {
    width: 18px;
    height: 18px;
}

NCTI--NctiContextMenu::right-arrow {
    image: url(:/ContextMenu/right_arrow.svg);
    width: 18px;
    height: 18px;
}

NCTI--NctiContextMenu::item {
	border: 0px solid transparent;
    margin: 1px 5px 1px 5px;
	padding: 0px 0px 0px 5px;
	min-height: 26px;
	color: #52555A;
	font-size: 13px;
	font-family: "HarmonyOS Sans", "HarmonyOS Sans SC";
}

NCTI--NctiContextMenu::item:selected,
NCTI--NctiContextMenu::item:hover {
    background-color: rgba(102, 121, 168, 0.08);
}

NCTI--NctiContextMenu::item::indicator {
	width: 18px;
    height: 18px;
} 
/* ====================================================================================================*/
/*悬浮工具栏*/
NCTI--NctiFloatToolBar QComboBox{
	min-width: 100px;
	min-height: 26px;
	border-radius: 2px;
	font-family: "HarmonyOS Sans SC";
	font-size: 14px;
	color: #ABB1BA;
	background-color: rgb(57, 70, 96);
}

NCTI--NctiFloatToolBar QComboBox:!focus{
	border: 1px solid rgba(102, 119, 153, 0.5);
	background-color: rgb(240, 242, 247, 0.1);
	color: #ABB1BA;
}

NCTI--NctiFloatToolBar QComboBox::editable {
	background-color: rgb(240, 242, 247);
	color: #777B80;
}

NCTI--NctiFloatToolBar QComboBox::drop-down{
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 34px;
	border:none;
}
NCTI--NctiFloatToolBar QComboBox::down-arrow{
	image: url(:/Common/drop_down.svg);
	padding: 0px;
}

NCTI--NctiFloatToolBar QComboBox QListView{
	background-color: #fbfcfe;
	color: #52555A;
	font-family: "HarmonyOS Sans SC";
	font-size: 13px;
	border: 1px solid rgba(102, 119, 153, 0.15);
	border-radius: 2px;
}
NCTI--NctiFloatToolBar QComboBox QListView::item{
	min-height: 26px;
	color: #52555A;
}
NCTI--NctiFloatToolBar QComboBox QListView::item:selected {
    background-color: #DDE4F1; 
}
NCTI--NctiFloatToolBar QComboBox QListView::item:!selected {
    background-color: transparent; 
}
/* ====================================================================================================*/
/* Dock的标题栏 */
NCTI--DockTitleBar{
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(243, 245, 248), stop: 1 rgb(210, 213, 216));
}
NCTI--DockTitleBar#dockTitleBar_commandConsole{
	background: rgb(229, 231, 234);
}
NCTI--DockTitleBar #label_title{
	color: rgb(81, 84, 87);
	font-family: "HarmonyOS Sans SC";
	font-size: 12px;
	margin-left: 10px;
	margin-top: 6px;
	margin-bottom: 6px;
}
NCTI--DockTitleBar #pushButton_close{
	border: none;
	image: url(:/Common/dock_close.svg);
	min-width: 14px;
	max-width: 14px;
	min-height: 14px;
	max-height: 14px;
	border-radius: 4px;
	padding: 4px;
	margin-right: 10px;
}
NCTI--DockTitleBar #pushButton_close:hover{
	background-color: #17000000;
}
NCTI--DockTitleBar #pushButton_close:pressed{
	background-color: #1f000000;
}
/* ====================================================================================================*/
/* 对象树 */
QFrame#objTree_separator{
	color: #dee3ed;
}

QToolButton[objTreeSidebar_toolbutton=true]{
    border: none; 
	background-color: transparent;
}
QToolButton[objTreeSidebar_toolbutton=true]:!checked{
    background-color: transparent;
}
QToolButton[objTreeSidebar_toolbutton=true]:checked{
    background-color: #EBF3FE;
}

NCTI--NctiObjectTree{
    background-color: #FFFFFF;
}
NCTI--NctiTreeView{
	background-color: #FFFFFF;
    border: none; 
	padding-left: 5px;
	padding-top: 5px;
}
NCTI--NctiTreeView::item{
  border: 0;
  font-family: "HarmonyOS Sans", "HarmonyOS Sans SC";
}
NCTI--NctiTreeView::item:hover{
  background-color: #F8F9FC;
}
NCTI--NctiTreeView::item:selected{
  border: 0;
  background-color: #EBF3FE;
  color: #52555A;
}
NCTI--NctiTreeView::item:!selected{
  background-color: #FFFFFF;
  color: #52555A;
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings  {
    border-image: none;
    image: url(:/Tree/collapse.svg);
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(:/Tree/expand.svg);
}
/* ====================================================================================================*/
/* 滚动条样式*/
QScrollBar:vertical{
    background-color: #07000000; 
    width: 12px;
    padding-left: 3px;
    padding-right: 3px;
    margin: 0px 1px 0px 1px;
}
QScrollBar::handle:vertical{
    background-color: #1f000000; 
    width: 12px;
    border:none;
    border-radius: 2px;
    margin-top: 3px;
    margin-bottom: 3px;
    min-height: 30px;
}
QScrollBar::add-page:vertical{
    background-color: transparent; 
}
QScrollBar::sub-page:vertical{
    background-color: transparent; 
}
QScrollBar::up-arrow:vertical{    
}
QScrollBar::down-arrow:vertical{ 
}
QScrollBar::sub-line:vertical{
    subcontrol-origin: margin; 
    border: none; 
    height:0px;
}
QScrollBar::add-line:vertical{
    subcontrol-origin: margin; 
    border: none; 
    height:0px;
}
/* ====================================================================================================*/
/* 右边栏*/
NCTI--NctiQtRightSideView{
	background-color: white;;
}
/* ====================================================================================================*/
